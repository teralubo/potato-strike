{
  "name": "potato-strike",
  "version": "1.4.1",
  "private": true,
  "description": "Lightweight CS-like Potato Strike prototype.",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "scripts": {
    "serve": "node server.js",
    "verify": "node scripts/verify.js",
    "build:editor-vendor": "esbuild DEV-tools/three-vendor-entry.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=game/vendor/three.min.js && node scripts/clean-editor-vendor.js",
    "build:single": "node scripts/build-single-html.js",
    "assets:freedoom": "node DEV-tools/extract-freedoom-weapons.js",
    "package:offline": "node scripts/package-offline.js",
    "phone:sync": "node scripts/sync-phone-assets.js",
    "package:compat": "node scripts/package-compat.js",
    "package:beta-final": "node scripts/package-beta-final.js",
    "start": "electron .",
    "start:safe": "electron . --safe-offline",
    "start:editor": "electron . --editor",
    "build:win": "electron-builder --win portable",
    "build:win:compat": "electron-builder --win portable --x64 --ia32",
    "build:linux": "electron-builder --linux dir AppImage",
    "build:linux:compat": "electron-builder --linux AppImage deb rpm tar.gz"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "local.potatostrike.game",
    "productName": "Potato Strike",
    "files": [
      "PotatoStrike.html",
      "game/index.html",
      "game/editor.html",
      "game/styles.css",
      "game/editor.css",
      "game/game.js",
      "game/editor.js",
      "game/vendor/three.min.js",
      "game/vendor/THREE-LICENSE.txt",
      "game/assets/**/*",
      "main.js",
      "preload.js",
      "configs/default-config.json",
      "mods/**/*",
      "server.js"
    ],
    "win": {
      "target": "portable",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "dir",
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "category": "Game"
    }
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
